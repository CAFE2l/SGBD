# ── Neon (Postgres serverless) ──────────────────────────────
# Connection string obtida no painel do Neon (Project → Connection details)
# Ex: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# ── Firebase ────────────────────────────────────────────────
# Config do projeto Firebase Console (Project settings → Your apps → SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Parâmetros da aplicação (opcionais, com defaults no código) ──
# Timeout de execução de query em ms (default: 10000)
QUERY_TIMEOUT_MS=10000
# Expiração dos schemas de importação em horas (default: 24)
SCHEMA_TTL_HOURS=24
